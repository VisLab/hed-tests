        ],
        "name": "value-invalid-date-time-format",
        "description": "A dateTimeClass value does not have the BIDS Datetime format (RFC 3339 with an optional offset), or its date does not exist in the Gregorian calendar.",
        "warning": false,
        "schema": "8.4.0",
        "error_category": "validation",
        "common_causes": [
            "Giving a date without a time, or a time without seconds",
            "Using an offset without a colon (+0200) or a lowercase t or z",
            "An hour of 24, a month or day out of range, or more than six fractional digits",
            "A day the month does not have, such as February 31 or February 29 of a non-leap year"
        ],
        "explanation": "A dateTimeClass value is YYYY-MM-DDThh:mm:ss, an optional fraction of one to six digits, and an optional Z or +hh:mm or -hh:mm offset: the BIDS Datetime format, which NWB also accepts. The hour is 00-23, the minute 00-59, the second 00-60. The date must also exist in the Gregorian calendar: 2026-02-31 and 2027-02-29 are invalid, 2028-02-29 is valid. The BIDS specification says validators should reject non-existent dates; HED validators do.",
        "correction_strategy": "Write the full date and time with a T separator and, if present, a Z or +hh:mm offset",
        "correction_examples": [
            {
                "wrong": "Creation-date/2026-09-30",
                "correct": "Creation-date/2026-09-30T00:00:00",
                "explanation": "The time part is required"
            },
            {
                "wrong": "Creation-date/2026-09-30T09:55:00+0200",
                "correct": "Creation-date/2026-09-30T09:55:00+02:00",
                "explanation": "An offset is +hh:mm with the colon"
            },
            {
                "wrong": "Creation-date/2026-09-30T24:00:00",
                "correct": "Creation-date/2026-10-01T00:00:00",
                "explanation": "The hour is 00-23; midnight at the end of a day is 00:00:00 of the next"
            },
            {
                "wrong": "Creation-date/2026-02-31T09:55:00",
                "correct": "Creation-date/2026-02-28T09:55:00",
                "explanation": "February 2026 has 28 days"
            }
        ],
        "correction_patterns": [
