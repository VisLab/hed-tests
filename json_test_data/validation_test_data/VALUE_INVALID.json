        "correction_examples": [
            {
                "wrong": "response_time column value abc with annotation Distance/# m",
                "correct": "7.3",
                "explanation": "A Distance placeholder needs a number"
            },
            {
                "wrong": "response_time column value 7,3 with annotation Distance/# m",
                "correct": "7.3",
                "explanation": "A decimal point, not a comma; a comma also splits the HED string"
            }
        ],
        "correction_patterns": [
            "Check every value in a placeholder column against its value class, not only the rows a template uses",
            "Use n/a for rows where the column has no value"
        ],
        "fix_instructions": [
            "1. Find the column's annotation template and its placeholder tag",
            "2. Look up the tag's unit class or value class in the schema",
            "3. Check every value in the column that is not n/a against it",
            "4. Correct the value or set it to n/a"
