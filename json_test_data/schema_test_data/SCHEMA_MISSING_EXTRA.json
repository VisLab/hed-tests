[
    {
        "error_code": "SCHEMA_MISSING_EXTRA",
        "name": "schema-missing-extra",
        "warning": true,
        "description": "An extras section (Sources, Prefixes, or External annotations) has a row with an empty column value.",
        "schema": "",
        "error_category": "schema_development",
        "common_causes": [
            "A required column of an extras row was left empty when the row was added",
            "A row was copied from a template and not all columns were filled in",
            "The value was accidentally deleted while editing, leaving 'key=' with nothing after it",
            "A placeholder row was committed before its real values were known"
        ],
        "explanation": "The extras sections of a HED schema (Sources, Prefixes, and External annotations) are tables in which every row must give a non-empty value in every column: source, link, and description in Sources; prefix, namespace, and description in Prefixes; prefix, id, iri, and description in External annotations. A row that supplies a column key but leaves its value empty (for example 'source=' or 'namespace=') is incomplete, and schema loading reports this warning. The sections themselves are optional in the file: a schema without them is loaded with empty extras sections, and their absence is not an error.",
        "correction_strategy": "Fill in every empty column of the flagged extras row, or delete the row entirely if there is no value to record",
        "correction_examples": [
            {
                "wrong": "* <nowiki>source=,link=https://fooddb.example.org,description=A botanical database.</nowiki>",
                "correct": "* <nowiki>source=FoodDB,link=https://fooddb.example.org,description=A botanical database.</nowiki>",
                "explanation": "The 'source' column of a Sources row was empty; the source name was filled in"
            },
            {
                "wrong": "* <nowiki>prefix=foodonto:,namespace=,description=Food Ontology</nowiki>",
                "correct": "* <nowiki>prefix=foodonto:,namespace=http://purl.obolibrary.org/obo/foodon.owl,description=Food Ontology</nowiki>",
                "explanation": "The 'namespace' column of a Prefixes row was empty; the ontology namespace was filled in"
            },
            {
                "wrong": "* <nowiki>prefix=foodonto:,id=,iri=http://example.org/123,description=A name property.</nowiki>",
                "correct": "* <nowiki>prefix=foodonto:,id=has_botanical_name,iri=http://example.org/123,description=A name property.</nowiki>",
                "explanation": "The 'id' column of an External annotations row was empty; the annotation id was filled in"
            },
            {
                "wrong": "* <nowiki>source=FoodDB,link=,description=A botanical database.</nowiki>",
                "correct": "* <nowiki>source=FoodDB,link=https://fooddb.example.org,description=A botanical database.</nowiki>",
                "explanation": "The 'link' column of a Sources row was empty; every column of an extras row must have a value, not only the key column"
            }
        ],
        "specification_reference": "3.1.4.10. Optional extra sections; Appendix B SCHEMA_MISSING_EXTRA",
